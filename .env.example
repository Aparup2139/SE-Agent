# NVIDIA NIM -- sole LLM provider for SE-Agent
NVIDIA_API_KEY=
NVIDIA_MODEL=moonshotai/kimi-k3
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_TIMEOUT=300
NVIDIA_MAX_RETRIES=5

# Optional tuning
NVIDIA_MAX_TOKENS=16384
NVIDIA_TEMPERATURE=1.0
NVIDIA_SEED=0
# Kimi K3 accepts "low" and "max" (not "medium").
# Measured on a trivial prompt: low ~58s, max ~111s per model turn. A full
# SE-Agent run is 20+ turns, so this dominates wall-clock time. "max" is the
# default; drop to "low" when you want a run to finish quickly.
NVIDIA_REASONING_EFFORT=max

# SE-Agent runtime
SE_AGENT_MAX_ITERATIONS=5
# Nodes allowed to run at once. Unset means unbounded, so repository and risk
# analysis overlap. Set to 1 on a tightly rate-limited NIM tier, where the
# doubled request rate can cost more in 429 retries than the parallelism saves.
# SE_AGENT_MAX_CONCURRENCY=1
SE_AGENT_TARGET_REPO=.

# Sandbox. Repository code runs through sandbox/local.sh, which uses the
# strongest isolation this host provides: bwrap > unshare > none.
#
# A run REFUSES TO START on the "none" tier -- a clean environment is not a
# boundary -- unless you accept that deliberately:
# SE_AGENT_SANDBOX_ALLOW_UNSAFE=1
#
# On Windows the namespaces are Linux's, so reach a real tier through WSL.
# Note this runs the tests with WSL's toolchain, so the project's
# dependencies must be installed there too.
# SE_AGENT_SANDBOX_WSL=Ubuntu-24.04
#
# Refuse to run below a named tier, rather than silently accepting less.
# SE_AGENT_SANDBOX_REQUIRE=bwrap
#
# A directory to put first on PATH inside the sandbox, when the workspace has
# no .venv of its own.
# SE_AGENT_SANDBOX_PATH=
#
# Point at a different isolation script entirely.
# SE_AGENT_SANDBOX_CMD=

# HTTP server (app/server.py). A run writes files and executes code, so both
# controls below bound that authority.
# Bearer token required on every run request. Without it the server refuses
# any caller that is not on loopback.
# SE_AGENT_API_TOKEN=
# The only directory tree an HTTP request may target. Without it the `repo`
# field is refused and runs use the server's own working directory.
# SE_AGENT_REPO_ROOT=
