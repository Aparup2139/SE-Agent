# NVIDIA NIM -- sole LLM provider for SE-Agent
NVIDIA_API_KEY=
NVIDIA_MODEL=moonshotai/kimi-k3
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_TIMEOUT=300
NVIDIA_MAX_RETRIES=5

# Optional tuning
NVIDIA_MAX_TOKENS=16384
NVIDIA_TEMPERATURE=1.0
NVIDIA_SEED=0
NVIDIA_REASONING_EFFORT=max

# SE-Agent runtime
SE_AGENT_MAX_ITERATIONS=5
SE_AGENT_TARGET_REPO=.
SE_AGENT_DOCKER_IMAGE=se-agent-sandbox:latest
